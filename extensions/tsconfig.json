{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["chrome"],
    "baseUrl": ".",
    "paths": {
      "@bindings/*": ["../apps/desktop/src/bindings/*"],
      "@shared/*": ["../apps/desktop/src/shared/*"]
    }
  },
  "include": ["shared/src", "build.mjs", "vitest.config.mjs"]
}
